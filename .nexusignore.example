# Nexus Space ignore rules (gitignore-like globs, POSIX separators)
# Ignore build and dependency folders
node_modules/**
.next/**
out/**
dist/**
build/**
coverage/**

# Ignore generated files
**/*.min.js
**/*.map
**/*.generated.*

# Ignore local env / secrets
**/.env*
**/*.pem
**/*.key

# Next.js sample: ignore app cache + exported static output
.turbo/**
.vercel/**
public/export/**
